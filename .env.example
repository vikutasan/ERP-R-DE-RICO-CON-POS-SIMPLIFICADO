# Credenciales de la Base de Datos — NO subir valores reales a GitHub
POSTGRES_USER=user
POSTGRES_PASSWORD=CAMBIAR_AQUI
POSTGRES_DB=rderico
DATABASE_URL=postgresql+asyncpg://user:CAMBIAR_AQUI@db:5432/rderico

# v19 (Fase 19.0): URL del API para el frontend Vite.
# Vite SOLO expone variables con prefijo VITE_ (import.meta.env.VITE_*).
# Debe coincidir con docker-compose.yml:47 (VITE_API_URL).
# En produccion, cambiar por la IP/host real del servidor de API.
# v19.1-hotfix: dejar VACIO para que el frontend use el hostname del navegador.
# Solo definir si el API vive en un host distinto al del frontend (dominio publico).
VITE_API_URL=
