# Credenciales de la Base de Datos — NO subir valores reales a GitHub
POSTGRES_USER=user
POSTGRES_PASSWORD=CAMBIAR_AQUI
POSTGRES_DB=rderico
DATABASE_URL=postgresql+asyncpg://user:CAMBIAR_AQUI@db:5432/rderico

# v19 (Fase 19.0): URL del API para el frontend Vite.
# Vite SOLO expone variables con prefijo VITE_ (import.meta.env.VITE_*).
# Debe coincidir con docker-compose.yml:47 (VITE_API_URL).
# En produccion, cambiar por la IP/host real del servidor de API.
# v19.1-hotfix: dejar VACIO para que el frontend use el hostname del navegador.
# Solo definir si el API vive en un host distinto al del frontend (dominio publico).
VITE_API_URL=

# =============================================================================
# IA LOCAL — Motor de IA (Whisper + YOLO + Ollama)
# =============================================================================
# Ver: PLANOS-ARQUITECTONICOS-DEL-NUEVO-POS/07-ia-local/ESPECIFICACION_IA_LOCAL_Y_MULTIMODAL.md
#
# REGLA DE ORO: si el motor de IA no esta disponible, el ERP sigue operando
# en modo manual. El POS NUNCA se rompe porque la IA no este.
#
# AI_LOCAL_ENABLED: interruptor maestro. APAGADO por defecto (modo manual puro).
#   - false -> el ERP no intenta usar IA. Cero riesgo.
#   - true  -> el ERP delega al motor en AI_LOCAL_URL.
AI_LOCAL_ENABLED=false

# AI_LOCAL_URL: URL base del motor de IA. Define el MODO (spec D-2):
#   M1 - Local por sucursal : http://ia-local:9000
#   M2 - Local central      : http://ia-matriz:9000
#   M3 - Nube               : https://api.proveedor-ia.com/v1
# VACIO = no configurado = modo manual.
AI_LOCAL_URL=

# AI_LOCAL_TIMEOUT: segundos antes de degradar a 503. Default 30.
AI_LOCAL_TIMEOUT=30

# AI_LOCAL_MODE: etiqueta INFORMATIVA para diagnostico y UI.
#   Valores: local | central | cloud
# IMPORTANTE: el comportamiento NUNCA debe ramificar segun este valor.
# Si el codigo hace `if mode == "cloud"`, es un error de diseno (spec §2.3).
AI_LOCAL_MODE=local

# --- Variables del motor (solo las usa docker-compose.ai.yml) ---
# Whisper: base (CPU, ~150 MB) | small | medium (requiere mas RAM/GPU)
WHISPER_MODEL=base
# YOLO: yolov8n.pt (nano, CPU ~30 FPS) | yolov8s.pt | yolov8m.pt
YOLO_MODEL=yolov8n.pt
# LLM: qwen2.5:3b (CPU, ~3 GB) | llama3.1:8b (requiere ~8 GB)
LLM_MODEL=qwen2.5:3b
